title: Root Scene
new-page: true
go-to: start_menu

@start_menu
new-page: true
style: main-menu
set-bg: https://raw.githubusercontent.com/NapoleonIVBonaparte/SFRY/main/out/html/img/bu/menu_bg.jpg
go-to: start_menu_2
on-arrival: {!
// ===== Brotherhood and Unity: sidebar values =====
// Set on the main menu, so the sidebar is already filled in there.
// The numbers are placeholders until the first scene is written.
// Stats run from 0 to 100.

// Shown until the first scene opens (see 1928_main below).
Q.date_text = "Post-Tito";

// Main
Q.primary_org = "LCY";
Q.org_strength = 50;
Q.person_of_note = "Expected";
// Right-hand Person of Note panel stays hidden until the first scene.
Q.pon_name = "";

// Government
Q.president_title = "President of the Presidency";
Q.sfry_president = "Lazar Mojsov";
Q.fec_chairman = "Branko Mikulić";
Q.primary_fed_org = "LCY";

// Federation: republics and autonomous provinces
// codes: bih, cro, mac, mne, ser, slo, kos (Kosovo), voj (Vojvodina)
Q.fed_units = ['bih', 'cro', 'mac', 'mne', 'ser', 'slo', 'kos', 'voj'];
for (var i = 0; i < Q.fed_units.length; i++) {
    var u = Q.fed_units[i];
    Q[u + '_stability'] = 50;        // Political Stability
    Q[u + '_fed_attitude'] = 50;     // Federal Attitude
    Q[u + '_street_pressure'] = 10;  // Street Pressure
}

// Defense & Security
Q.jna_readiness = 50;
Q.jna_quality = 50;
Q.jna_cohesion = 50;
Q.sdb_quality = 50;
Q.sdb_cohesion = 50;
Q.sdb_loyalty = 50;
Q.to_readiness = 50;
Q.to_quality = 50;
Q.to_cohesion = 50;

// Polls stay hidden until elections exist.
Q.elections_enabled = 0;
// ===== end of Brotherhood and Unity values =====

// Main menu styling. It is injected here (rather than in game.css) so that it
// also works when this game is loaded as a mod through the base game's Mods menu.
if (!document.getElementById('bu-menu-style')) {
    var css = '' +
        '#content.main-menu { text-align: center; }' +
        '#content.main-menu .bu-hero { margin: -1em -1.5em 1.5em -1.5em; padding: 2.5em 1em 2.2em 1em;' +
        '  background: linear-gradient(rgba(0,0,0,0.22), rgba(0,0,0,0.22)),' +
        '  url(https://raw.githubusercontent.com/NapoleonIVBonaparte/SFRY/main/out/html/img/bu/title_banner.jpg) center 40% / cover no-repeat; }' +
        '#content.main-menu .bu-star { color: #de0000; font-size: 3em; line-height: 1;' +
        '  text-shadow: 0 0 3px #ffd700, 0 0 3px #ffd700, 0 0 3px #ffd700; }' +
        '#content.main-menu .bu-title { color: #fff; font-size: 2em; text-transform: uppercase; letter-spacing: 0.12em;' +
        '  margin-top: 0.3em; text-shadow: 2px 2px 4px rgba(0,0,0,0.8); white-space: nowrap; line-height: 1.2; }' +
        '#content.main-menu ul.choices { border: none; max-width: none; margin: 0; }' +
        '#content.main-menu ul.choices li { position: relative; height: 5.5em; padding: 0; margin-bottom: 0.7em;' +
        '  border: 2px solid #876; border-radius: 4px; overflow: hidden; background-color: #222;' +
        '  background-repeat: no-repeat; background-size: cover; transition: filter 0.15s; }' +
        '#content.main-menu ul.choices li:last-child { border-bottom: 2px solid #876; margin-bottom: 0; }' +
        '#content.main-menu ul.choices li:hover { filter: brightness(1.25); background-color: #222; }' +
        '#content.main-menu ul.choices li a { display: flex; align-items: center; justify-content: center; height: 100%;' +
        '  color: #fff; font-size: 1.35em; text-transform: uppercase; letter-spacing: 0.15em;' +
        '  text-shadow: 2px 2px 4px rgba(0,0,0,0.9), 0 0 8px rgba(0,0,0,0.8); }' +
        '#content.main-menu ul.choices li:nth-child(1) { background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)), url(https://raw.githubusercontent.com/NapoleonIVBonaparte/SFRY/main/out/html/img/bu/btn_play.jpg); background-position: center 20%; }' +
        '#content.main-menu ul.choices li:nth-child(2) { background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)), url(https://raw.githubusercontent.com/NapoleonIVBonaparte/SFRY/main/out/html/img/bu/btn_load.jpg); background-position: center 30%; }' +
        '#content.main-menu ul.choices li:nth-child(3) { background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)), url(https://raw.githubusercontent.com/NapoleonIVBonaparte/SFRY/main/out/html/img/bu/btn_settings.jpg); background-position: center 35%; }' +
        '#content.main-menu ul.choices li:nth-child(4) { background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)), url(https://raw.githubusercontent.com/NapoleonIVBonaparte/SFRY/main/out/html/img/bu/btn_achievements.jpg); background-position: center 37%; }' +
        '#content.main-menu ul.choices li:nth-child(5) { background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)), url(https://raw.githubusercontent.com/NapoleonIVBonaparte/SFRY/main/out/html/img/bu/btn_credits.jpg); background-position: center 30%; }' +
        'body:has(#content.main-menu) #bg1 { background-position: center; }' +
        '#game-title .bu-blue { color: #003893; text-shadow: 0 0 3px #fff, 0 0 3px #fff; }' +
        '#game-title .bu-white { color: #fff; text-shadow: 0 0 3px #000, 0 0 3px #000; }' +
        '#game-title .bu-red { color: #de0000; text-shadow: 0 0 3px #fff, 0 0 3px #fff; }' +
        '#game-author { text-shadow: 0 0 3px #fff, 0 0 3px #fff; }' +
        '.bu-yu-b, .bu-yu-w, .bu-yu-r { font-style: italic;' +
        '  text-shadow: 1px 1px 0 rgba(0,0,0,0.22), -1px -1px 0 rgba(0,0,0,0.22), 1px -1px 0 rgba(0,0,0,0.22), -1px 1px 0 rgba(0,0,0,0.22); }' +
        '.bu-yu-b { color: #003893; }' +
        '.bu-yu-w { color: #fff; }' +
        '.bu-yu-r { color: #de0000; }' +
        '.bu-lcy { color: #de0000; font-style: italic; }';
    var styleEl = document.createElement('style');
    styleEl.id = 'bu-menu-style';
    styleEl.textContent = css;
    document.head.appendChild(styleEl);
}
// Shrink the big menu title until it fits on one line, whatever the
// player's font or screen size.
window.buFitTitle = function() {
    var t = document.querySelector('#content.main-menu .bu-title');
    if (!t) { return; }
    var size = 2;
    t.style.fontSize = size + 'em';
    while (t.scrollWidth > t.clientWidth && size > 0.8) {
        size -= 0.05;
        t.style.fontSize = size + 'em';
    }
};
if (!window.buFitTitleOnResize) {
    window.buFitTitleOnResize = true;
    window.addEventListener('resize', window.buFitTitle);
}
document.title = 'Brotherhood and Unity';
var titleEl = document.getElementById('game-title');
if (titleEl) {
    titleEl.innerHTML = '<span class="bu-blue">Brotherhood</span> <span class="bu-white">and</span> <span class="bu-red">Unity</span>';
}
var authorEl = document.getElementById('game-author');
if (authorEl) { authorEl.textContent = 'SaGrace'; }
!}

{!<div class="bu-hero"><div class="bu-star">&#9733;</div><div class="bu-title">Brotherhood and Unity</div></div>!}

@start_menu_2
style: main-menu
on-display: {! if (window.buFitTitle) { window.buFitTitle(); } !}
set-bg: https://raw.githubusercontent.com/NapoleonIVBonaparte/SFRY/main/out/html/img/bu/menu_bg.jpg

# The order of these buttons matters: each one's background image is matched by position (see the CSS above).
- @start: Play
- @menu_load: Load game
- @menu_settings: Settings
- @game_over.achievements: Achievements
- @credits: Credits

@menu_load
on-arrival: {! window.dendryUI.showSaveSlots(); !}
go-to: start_menu

@menu_settings
on-arrival: {! window.showOptions(); !}
go-to: start_menu


@start
on-arrival: started = 1
set-bg: none
new-page: true

= Introduction

> *"None of our republics would be anything if we weren't all together; but we have to create our own history - history of United {!<span class="bu-yu-b">Yugo</span><span class="bu-yu-w">sla</span><span class="bu-yu-r">via</span>!}, also in the future."*

 - Josip Broz Tito

While history has indeed proven the Marshal correct, and as the current ex-Yugoslav republics are little more than the playing field of 'great powers' for their business or other interests - it did not have to be so. Indeed, it does not have to be so either, change is always possible, and perhaps inevitable if one takes the positive stance. However, you are about to enter the heydays of the Socialist {!<span class="bu-yu-b">Yugo</span><span class="bu-yu-w">sla</span><span class="bu-yu-r">via</span>!}.

Your mission is, relatively, simple: to try and preserve a functional Yugoslav federal or even unitary state. If possible, you ought to try to preserve the party (seeing as you start by playing it, or a part anyway) - nonetheless, the survival of the {!<span class="bu-lcy">LCY</span>!} is a secondary objective: saving {!<span class="bu-yu-b">Yugo</span><span class="bu-yu-w">sla</span><span class="bu-yu-r">via</span>!}, and preventing the horrors that await if vampiric nationalism arises again - is paramount.

- @scene_1987_09_23: Begin
